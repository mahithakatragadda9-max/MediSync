# MediSync Backend Environment Configuration
# Copy to .env and fill in credentials when moving beyond Local Demo Mode.

# Demo mode is automatically enabled when SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are unset.
MEDISYNC_DEMO_MODE=true

# JWT Secret for local session tokens (override in production)
MEDISYNC_JWT_SECRET=change-me-to-a-long-random-secret-in-production

# Optional Supabase Configuration (PostgreSQL + Supabase Auth + RLS)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Groq LLM Key for enhanced clinical text extraction & contextual AI synthesis
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# CORS Origins (comma-separated)
MEDISYNC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,null
